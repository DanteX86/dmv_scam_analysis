<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>DMV Scam Analysis - Detailed Dashboard</title>
    <meta http-equiv="refresh" content="45" />
    <style>
        body { font-family: Arial, sans-serif; margin: 24px; background: #f8fafc; color: #233;
               display: grid; grid-template-columns: 260px 1fr; gap: 20px; }
        aside { background: #fff; border-radius: 10px; padding: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        main { background: #fff; border-radius: 10px; padding: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        h1, h2 { color: #2c3e50; }
        .metric { font-size: 1.6em; font-weight: bold; }
        .section { margin-bottom: 24px; }
        ul { line-height: 1.7; }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 12px; background: #eef; color: #224; margin-right: 4px; }
        .badge.red { background: #fee; color: #922; }
        .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    </style>
</head>
<body>
    <aside>
        <h2>Summary</h2>
        <div class="section">
            <div class="metric">{{ total_threats }}</div>
            <div>Total Threats</div>
        </div>
        <div class="section">
            <div class="metric">{{ recent_threats_count }}</div>
            <div>Threats (Last 24h)</div>
        </div>
        <div class="section">
            <div class="metric">{{ high_risk_count }}</div>
            <div>High Risk</div>
        </div>
        <div class="section">
            <div class="metric">{{ active_alerts }}</div>
            <div>Active Alerts</div>
        </div>
        <div class="section">
            <small>Last Updated</small>
            <div>{{ updated_at }}</div>
        </div>
    </aside>
    <main>
        <h1>Detailed Dashboard</h1>
        <div class="grid2">
            <div class="section">
                <h2>Recent High-Risk Threats</h2>
                <ul>
                    {% if recent_high_risk and recent_high_risk|length > 0 %}
                        {% for t in recent_high_risk %}
                            <li>[{{ t.timestamp }}] Score: {{ '%.2f'|format(t.threat_score) }}
                                <span class="badge red">{{ t.source }}</span></li>
                        {% endfor %}
                    {% else %}
                        <li>No high-risk threats in the last 24 hours.</li>
                    {% endif %}
                </ul>
            </div>
            <div class="section">
                <h2>Notes</h2>
                <p>This detailed view is a starter template. You can embed charts, tables, and richer
                analytics here by extending the context and template design.</p>
            </div>
        </div>
    </main>
</body>
</html>
