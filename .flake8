[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    releases,
    .venv,
    .tox,
    .mypy_cache,
    .pytest_cache,
    .vscode,
    .github,
    docs/conf.py
per-file-ignores =
    __init__.py: F401, F403
    tests/*: S101, S105, S404, S603, S607
max-complexity = 10
docstring-convention = google
statistics = True
count = True
show-source = True
